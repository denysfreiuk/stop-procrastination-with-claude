# Єдиний конфіг системи: його читають бот, плагін Claude Code і setup.
# Файл .env у git не потрапляє. Створи його через setup або скопіюй цей файл у .env.

# --- Telegram ---

# Токен бота від @BotFather. Ніде більше його не зберігай і нікому не надсилай.
TELEGRAM_BOT_TOKEN=
# Твій числовий ID (дізнатися: @userinfobot). Бот відповідає лише йому, інших ігнорує.
TELEGRAM_USER_ID=

# --- Час ---

# Часовий пояс у форматі tz database. Від нього залежить, у чию нотатку потрапить запис.
TIMEZONE=Europe/Kyiv
# Час вечірнього нагадування, ГГ:ХХ. Змінити можна і командою боту /remind 20:00.
REMINDER_TIME=20:00

# --- Obsidian ---

# Шлях до vault: відносно цієї папки або абсолютний.
VAULT_PATH=obsidian

# --- Anki ---

# Коренева колода: під нею плагін створює всі свої колоди, наприклад Study::English::EN-UA.
ANKI_ROOT_DECK=Study
# Адреса AnkiConnect. Порт змінюй, лише якщо міняв webBindPort в налаштуваннях AnkiConnect.
ANKI_CONNECT_URL=http://127.0.0.1:8765
# Лише якщо в налаштуваннях AnkiConnect задано apiKey.
ANKI_CONNECT_KEY=
# Мова пояснень у картках, підсумках дня і тижневих оглядах (uk — українська).
ANKI_EXPLANATION_LANGUAGE=uk
# Рівень англійської і ціль: від них залежать слова і пояснення (A2, B1, B2, C1, C2).
ANKI_ENGLISH_LEVEL=B1
ANKI_ENGLISH_GOAL=C1
# Складність речень-прикладів у картках зі словами.
ANKI_EXAMPLE_LEVEL=B1-B2
# Скільки карток максимум генерувати за раз (1–50). Денні ліміти колод живуть у самій Anki.
ANKI_MAX_CARDS_PER_BATCH=15
# Через скільки днів інтервалу вмикаються відкладені картки UA→EN і форм.
ANKI_PROMOTE_AFTER_DAYS=3
# Синхронізувати з AnkiWeb після змін (true/false).
ANKI_AUTO_SYNC=true
# Озвучка слів і її вимова: en_US або en_GB. Після зміни попроси Claude «онови типи нотаток».
ANKI_TTS=true
ANKI_TTS_LANG=en_US
# Нагадувати в Claude Code, скільки карток чекає на повторення (true/false).
ANKI_REVIEW_REMINDER=true
# Короткий звук, коли Claude закінчив відповідь (true/false).
ANKI_SOUND_ON_STOP=false
