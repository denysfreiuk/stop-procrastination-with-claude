# Python / uv
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/

# Local config and secrets
.env
.env.*
!.env.example

# Plugin caches
.mcpb-cache/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

