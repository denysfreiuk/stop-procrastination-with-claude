node_modules/

# Bot data and logs
telegram-bot/data/
*.log

# Obsidian vault: an allowlist, so a new folder of notes stays private by default.
# Only the template of the vault is public; check_privacy.py enforces the same rule.
obsidian/*
!obsidian/Dashboard.md
!obsidian/CLAUDE.md
!obsidian/Templates/
!obsidian/.obsidian/
obsidian/.obsidian/*
!obsidian/.obsidian/daily-notes.json
!obsidian/.obsidian/templates.json
!obsidian/.obsidian/types.json
!obsidian/Journal/
obsidian/Journal/*
!obsidian/Journal/Daily/
obsidian/Journal/Daily/*
!obsidian/Journal/Daily/.gitkeep
!obsidian/Journal/Weekly/
obsidian/Journal/Weekly/*
!obsidian/Journal/Weekly/.gitkeep
!obsidian/Inbox/
obsidian/Inbox/*
!obsidian/Inbox/.gitkeep
!obsidian/Learning/
obsidian/Learning/*
!obsidian/Learning/ML/
!obsidian/Learning/English/
!obsidian/Learning/Uni/
obsidian/Learning/*/*
!obsidian/Learning/*/.gitkeep
